.DS_Store
.claude/tmp/*
!.claude/tmp/.gitkeep
.claude/program/*
!.claude/program/.gitkeep
!.claude/program/channels/
.claude/program/channels/*
!.claude/program/channels/PROTOCOL.md
!.claude/program/channels/program.md
!.claude/program/channels/feature.md
!.claude/program/schemas/
!.claude/program/schemas/**
node_modules/
examples/parallel-api/stubs/
# Local checkouts of sibling products (never ship inside this pack)
# Anchored to repo root only — must NOT match bench/src/ (the benchmark harness source).
/src/
**/__pycache__/
*.pyc

# Local audit working papers (not shipped, not tracked)
docs/audits/
.skailr/

# bench/docker-run.sh output — regenerated per local run, never committed.
/bench-docker-out/

# scripts/skailr/lib/db.mjs runtime state — regenerated per run, never committed.
.claude/skailr.db
.claude/skailr.db-journal
.claude/skailr.db-wal
.claude/skailr.db-shm
