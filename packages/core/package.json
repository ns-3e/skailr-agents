{
  "name": "@skailr/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node --test dist/**/*.test.js 2>/dev/null || node --test test/*.test.js"
  },
  "dependencies": {
    "zod": "^3.24.2",
    "minimatch": "^10.0.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.13.10"
  }
}
