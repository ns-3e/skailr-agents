#!/usr/bin/env bash
# Sample pre-commit: enforce ownership when a map exists.
# Install: cp scripts/hooks/pre-commit.sample .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
MAP="$ROOT/.claude/program/ownership.json"
if [[ -f "$MAP" ]]; then
  node "$ROOT/scripts/skailr/check-ownership.mjs" --map "$MAP" || {
    echo "skailr: ownership check failed" >&2
    exit 1
  }
fi
# Whole-installation health check (read-only, FAIL vs SKIP aware)
if [[ -f "$ROOT/scripts/skailr/doctor.mjs" ]]; then
  node "$ROOT/scripts/skailr/doctor.mjs" || {
    echo "skailr: doctor found a broken installation" >&2
    exit 1
  }
fi
